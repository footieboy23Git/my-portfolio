---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/site.config';

const tools = ['monday.com', 'Make', 'Figma', 'BambooHR', 'After Effects', 'InDesign', 'Photoshop', 'Workflow Automation', 'Resource Planning'];
---

<BaseLayout title="About" description={`A bit about ${SITE.name} and how they work.`}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">About</p>

    <!-- Header & Photo Card -->
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-8 mb-8">
      <div class="w-32 h-32 shrink-0 sm:w-40 sm:h-40">
        <img 
          src="/images/elijah.jpg" 
          alt={SITE.name} 
          width="400"
          height="400"
          class="rounded-2xl object-cover w-full h-full border border-line shadow-sm"
        />
      </div>
      <div>
        <h1 class="font-display text-ink text-3xl font-medium sm:text-4xl">
          {SITE.role}.
        </h1>
        <p class="text-ink-soft mt-2 text-sm font-mono">Based in London, UK</p>
      </div>
    </div>

    <!-- Bio Text -->
    <div class="prose prose-sm sm:prose-base space-y-4 text-ink-soft leading-relaxed">
      <p>
        I’m a Studio Manager with a background in creative production, workflow optimisation, and automation. Having built my career from the ground up as a designer and artworker, I understand the creative process from initial production through to final delivery.
      </p>
      <p>
        I use that hands-on experience to manage teams, improve workflows, and build systems that make creative operations more efficient and scalable. Currently at Wellcom London embedded at Christie's, I lead a team of three and oversee studio workload, resource planning, technical delivery, and process improvement.
      </p>
      <p>
        A large part of my focus is on the space between creative and operations: designing monday.com workflows and automations, building resource dashboards, and connecting tools across teams to remove friction so creatives can focus on doing great work.
      </p>
    </div>

    <div class="mt-10">
      <p class="text-ink-soft mb-4 font-mono text-xs tracking-[0.2em] uppercase">Core Focus Areas</p>
      <ul class="text-ink-soft space-y-2 text-sm leading-relaxed">
        <li><strong class="text-ink font-medium">Creative Operations & Workflow:</strong> End-to-end briefing, resource planning, and production handovers using monday.com and custom automations.</li>
        <li><strong class="text-ink font-medium">Resource & Capacity Management:</strong> Single-source systems that give teams clear visibility over workload, availability, and priorities.</li>
        <li><strong class="text-ink font-medium">Creative Systems & Governance:</strong> Global Figma frameworks that improve brand consistency, support onboarding, and enable team independence.</li>
        <li><strong class="text-ink font-medium">Technical Production:</strong> Hands-on expertise across After Effects, InDesign, Photoshop, Figma, print, and digital asset delivery.</li>
        <li><strong class="text-ink font-medium">Team Leadership:</strong> Managing direct reports and partnering with Account Management and Marketing to translate requirements into clear production plans.</li>
      </ul>
    </div>

    <div class="mt-10">
      <p class="text-ink-soft mb-3 font-mono text-xs tracking-[0.2em] uppercase">Toolkit</p>
      <ul class="flex flex-wrap gap-2">
        {
          tools.map((tool) => (
            <li class="border-line text-ink-soft rounded-full border px-3 py-1 font-mono text-xs">
              {tool}
            </li>
          ))
        }
      </ul>
    </div>

    <Button href={`mailto:${SITE.email}`} class="mt-10">Get in touch</Button>
  </section>
</BaseLayout>